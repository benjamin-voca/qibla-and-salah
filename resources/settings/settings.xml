<settings>
    <setting propertyKey="@Properties.useGps" title="@Strings.SetUseGps"><settingConfig type="boolean"/></setting>
    <setting propertyKey="@Properties.latitude" title="@Strings.SetLatitude"><settingConfig type="numeric" min="-90" max="90"/></setting>
    <setting propertyKey="@Properties.longitude" title="@Strings.SetLongitude"><settingConfig type="numeric" min="-180" max="180"/></setting>
    <setting propertyKey="@Properties.method" title="@Strings.SetMethod">
        <settingConfig type="list">
            <listEntry value="-1">@Strings.OptAuto</listEntry>
            <listEntry value="0">@Strings.M0</listEntry>
            <listEntry value="1">@Strings.M1</listEntry>
            <listEntry value="2">@Strings.M2</listEntry>
            <listEntry value="3">@Strings.M3</listEntry>
            <listEntry value="4">@Strings.M4</listEntry>
            <listEntry value="5">@Strings.M5</listEntry>
            <listEntry value="6">@Strings.M6</listEntry>
            <listEntry value="7">@Strings.M7</listEntry>
            <listEntry value="8">@Strings.M8</listEntry>
            <listEntry value="9">@Strings.M9</listEntry>
            <listEntry value="10">@Strings.M10</listEntry>
            <listEntry value="11">@Strings.M11</listEntry>
            <listEntry value="12">@Strings.M12</listEntry>
            <listEntry value="13">@Strings.M13</listEntry>
            <listEntry value="14">@Strings.M14</listEntry>
            <listEntry value="15">@Strings.M15</listEntry>
            <listEntry value="16">@Strings.M16</listEntry>
            <listEntry value="17">@Strings.M17</listEntry>
            <listEntry value="18">@Strings.M18</listEntry>
            <listEntry value="19">@Strings.M19</listEntry>
            <listEntry value="20">@Strings.M20</listEntry>
            <listEntry value="21">@Strings.M21</listEntry>
            <listEntry value="22">@Strings.M22</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.asrSchool" title="@Strings.SetAsr">
        <settingConfig type="list">
            <listEntry value="0">@Strings.OptAuto</listEntry>
            <listEntry value="1">@Strings.OptStandard</listEntry>
            <listEntry value="2">@Strings.OptHanafi</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.ishaEnd" title="@Strings.SetIshaEnd">
        <settingConfig type="list">
            <listEntry value="0">@Strings.OptMidnight</listEntry>
            <listEntry value="1">@Strings.OptFajr</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.highLat" title="@Strings.SetHighLat">
        <settingConfig type="list">
            <listEntry value="0">@Strings.OptAuto</listEntry>
            <listEntry value="1">@Strings.OptMiddle</listEntry>
            <listEntry value="2">@Strings.OptSeventh</listEntry>
            <listEntry value="3">@Strings.OptAngle</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.tune" title="@Strings.SetTune"><settingConfig type="alphaNumeric"/></setting>
    <setting propertyKey="@Properties.hijriAdjust" title="@Strings.SetHijri"><settingConfig type="numeric" min="-2" max="2"/></setting>
    <setting propertyKey="@Properties.notifyAtStart" title="@Strings.SetNotifyStart"><settingConfig type="boolean"/></setting>
    <setting propertyKey="@Properties.warnFajr" title="@Strings.SetWarnFajr"><settingConfig type="numeric" min="0" max="180"/></setting>
    <setting propertyKey="@Properties.warnDhuhr" title="@Strings.SetWarnDhuhr"><settingConfig type="numeric" min="0" max="180"/></setting>
    <setting propertyKey="@Properties.warnAsr" title="@Strings.SetWarnAsr"><settingConfig type="numeric" min="0" max="180"/></setting>
    <setting propertyKey="@Properties.warnMaghrib" title="@Strings.SetWarnMaghrib"><settingConfig type="numeric" min="0" max="180"/></setting>
    <setting propertyKey="@Properties.warnIsha" title="@Strings.SetWarnIsha"><settingConfig type="numeric" min="0" max="180"/></setting>
</settings>
